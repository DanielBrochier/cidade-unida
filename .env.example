# Supabase — em Project Settings > API no painel do Supabase.
# SUPABASE_SERVICE_ROLE_KEY é secreta: nunca vai para o navegador, nunca é commitada.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Domínio raiz em produção, sem subdomínio (ex: cidadeunida.com).
# Em dev local não precisa definir — "localhost" já funciona sozinho
# (ex: brochier.localhost:3000).
BASE_DOMAIN=

# Cidade usada quando o host não tem subdomínio reconhecido — útil enquanto
# não existe domínio próprio (ex: acessando direto por cidade-unida.vercel.app,
# que não permite subdomínio embaixo dele). Deixe em branco depois que tiver
# domínio com subdomínio por cidade.
CIDADE_PADRAO_SLUG=

# Não existe mais PAINEL_PASSWORD nem NEXT_PUBLIC_CIDADE_*: cada cidade tem seu
# próprio registro na tabela `cidades` (nome, UF, coordenadas, senha em hash),
# cadastrado via `npm run cidade -- <slug> <nome> <uf> <lat> <lng> <senha>`.
